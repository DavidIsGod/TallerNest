# ---------------------------------------------------------------- App
NODE_ENV=development
PORT=3000
# Zona horaria de los horarios de toma y de los jobs programados
APP_TIMEZONE=America/Bogota
# Orígenes CORS permitidos separados por coma ("*" = todos)
CORS_ORIGINS=*

# ---------------------------------------------------------------- Base de datos
# Si se define DATABASE_URL (Render/Railway/Neon) tiene prioridad sobre DB_*
# DATABASE_URL=postgres://user:pass@host:5432/mediplan
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mediplan
DB_SSL=false
DB_LOGGING=false

# ---------------------------------------------------------------- Seguridad
JWT_ACCESS_SECRET=cambie-este-secreto-de-access-token
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=cambie-este-secreto-de-refresh-token
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
TWO_FACTOR_APP_NAME=MediPlan
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5

# Administrador inicial (se crea al arrancar si no existe ninguno)
ADMIN_EMAIL=admin@mediplan.com
ADMIN_PASSWORD=Admin123*
ADMIN_NAME=Administrador MediPlan

# ---------------------------------------------------------------- Tomas
# Horas tras la hora programada para marcar una toma como OMITIDO
OMISION_HORAS=2
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- openFDA
OPENFDA_ENABLED=true
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_API_KEY=
OPENFDA_TIMEOUT_MS=5000

# ---------------------------------------------------------------- Twilio
# Sin credenciales las notificaciones quedan registradas como SIMULADA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# sms | whatsapp
TWILIO_CHANNEL=sms
NOTIFICACION_MAX_INTENTOS=3
